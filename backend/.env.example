# Node Environment & Server Port
PORT=5000
NODE_ENV=development

# MySQL connection for local development only
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/iktis_db"

# Session & security secrets; generate unique values for each environment
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
COOKIE_SECRET="replace-with-another-secure-random-secret"

# Allowed CORS origin for local development
FRONTEND_URL="http://localhost:5173"
